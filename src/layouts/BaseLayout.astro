---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  isArticle?: boolean;
  publishedTime?: string;
  currentCategory?: string;
  categories?: string[];
}

const {
  title = "Pathan Sir's Archive | इन्स्पायर कोचिंग क्लासेस, धर्माबाद",
  description = "जगातील सर्वोत्तम विचार, प्रेरणादायी कोट्स, पॉडकास्ट आणि व्हिडीओ — संकलन: पठाण सर (इन्स्पायर, धर्माबाद).",
  image = "/og-banner.svg",
  isArticle = false,
  publishedTime,
  currentCategory = "All",
  categories = ['All', 'Quote', 'Video', 'Podcast', 'Visual']
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://inspire-archive.pages.dev').href;
const socialImageUrl = new URL(image, Astro.site || 'https://inspire-archive.pages.dev').href;
---

<!DOCTYPE html>
<html lang="mr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="author" content="पठाण सर (Pathan Sir)" />
  <meta name="theme-color" content="#faf8f5" />

  <!-- Open Graph / WhatsApp Preview Meta Tags -->
  <meta property="og:type" content={isArticle ? "article" : "website"} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Pathan Sir's Archive" />
  <meta property="og:locale" content="mr_IN" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageUrl} />

  <!-- Google Fonts Preconnect: Poppins + Newsreader + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
</head>
<body>
  <Header currentCategory={currentCategory} categories={categories} />

  <main class="journal-stream">
    <slot />
  </main>

  <Footer />

  <!-- Instant Filtering Script -->
  <script>
    function setupCategoryFiltering() {
      const pills = document.querySelectorAll<HTMLButtonElement>('.pill-btn');
      const entries = document.querySelectorAll<HTMLElement>('.stream-entry');

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const category = pill.getAttribute('data-category');

          pills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');

          entries.forEach((entry) => {
            const entryCategory = entry.getAttribute('data-category');
            if (category === 'All' || entryCategory === category) {
              entry.classList.remove('is-hidden');
            } else {
              entry.classList.add('is-hidden');
            }
          });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', setupCategoryFiltering);
  </script>
</body>
</html>
