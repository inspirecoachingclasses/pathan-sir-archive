---
interface Props {
  currentCategory?: string;
  categories?: string[];
}

const { currentCategory = 'All', categories = ['All', 'Quote', 'Video', 'Podcast'] } = Astro.props;

const categoryLabels: Record<string, string> = {
  All: 'सर्व (All)',
  Quote: 'सुविचार (Quotes)',
  Video: 'व्हिडिओ (Videos)',
  Podcast: 'पॉडकास्ट (Podcasts)',
  Philosophy: 'तत्त्वज्ञान (Philosophy)'
};

// Filter out Visual if passed
const filteredCategories = categories.filter(c => c !== 'Visual');
---

<header class="site-masthead">
  <div class="container">
    <!-- Prominent Institute Brand -->
    <div class="institute-banner">
      <div class="institute-pill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
        </svg>
        इन्स्पायर कोचिंग क्लासेस, धर्माबाद
      </div>
      <span class="institute-subline">Inspire Coaching Classes Dharmabad • Class 9th - 10th Science | Class 11th - 12th Physics | MHT-CET | NEET</span>
    </div>

    <!-- Main Title -->
    <h1 class="masthead-title">
      <a href="/" style="color: inherit; text-decoration: none;">Pathan Sir’s Archive</a>
    </h1>
    <div class="masthead-subtitle">
      विचार धारा by <strong>पठाण सर</strong>
    </div>
    <p class="masthead-tagline">
      "जीवनाला दिशा देणारे जगातील प्रेरणादायी विचारांचा संग्रह."
    </p>
  </div>
</header>

<nav class="filter-sticky-strip">
  <div class="container">
    <div class="filter-pill-row" id="filterBar">
      {filteredCategories.map((cat) => (
        <button 
          type="button" 
          class={`pill-btn ${cat === currentCategory ? 'active' : ''}`}
          data-category={cat}
        >
          {categoryLabels[cat] || cat}
        </button>
      ))}
    </div>
  </div>
</nav>
